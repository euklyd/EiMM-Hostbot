# =============================================================================
# EiMM-Hostbot Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control!

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL password (use a strong, random password)
DB_PASSWORD=your_secure_password_here

# -----------------------------------------------------------------------------
# Discord Bot
# -----------------------------------------------------------------------------
# Bot token from Discord Developer Portal
# (Also needs to be in conf/settings.py - this is for future migration)
# DISCORD_TOKEN=your_discord_token_here

# -----------------------------------------------------------------------------
# Web Interface (OAuth)
# -----------------------------------------------------------------------------
# Discord OAuth2 credentials from Developer Portal -> OAuth2 section
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# OAuth redirect URI - must match what's configured in Discord Developer Portal
# For production: https://yourdomain.com/iv/auth/callback
# For local dev: http://localhost:8080/auth/callback
DISCORD_REDIRECT_URI=https://yourdomain.com/iv/auth/callback

# Session secret for signing cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=generate_a_random_32_byte_hex_string

# -----------------------------------------------------------------------------
# Backup Settings (optional)
# -----------------------------------------------------------------------------
# BACKUP_RETENTION_DAYS=7
